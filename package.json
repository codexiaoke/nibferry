{
  "name": "nibferry-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nibferry/react build && pnpm -r --parallel run '/^dev:.+$/'",
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @nibferry/react build && pnpm -r run typecheck",
    "test": "playwright test",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.15.0",
    "typescript": "5.9.3"
  }
}
