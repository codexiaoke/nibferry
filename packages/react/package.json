{
  "name": "nibferry",
  "version": "0.3.0",
  "description": "Nibferry React UI library and design tokens",
  "type": "module",
  "homepage": "https://codexiaoke.github.io/nibferry/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codexiaoke/nibferry.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./theme": {
      "types": "./dist/theme/tokens.d.ts",
      "import": "./dist/theme.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "dev:js": "vite build --watch --emptyOutDir=false",
    "dev:types": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@hugeicons/react": "1.1.10",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-presence": "1.1.11",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "4.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8"
  }
}
